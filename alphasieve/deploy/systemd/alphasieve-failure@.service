[Unit]
Description=Record AlphaSieve unit failure for %i

[Service]
Type=oneshot
WorkingDirectory=/data/alphasieve/deploy/current
Environment=ALPHASIEVE_ROLE=system
Environment=ALPHASIEVE_USER=systemd
ExecStart=/data/alphasieve/deploy/current/.venv/bin/alphasieve control unit-failed %i
TimeoutStartSec=30
RuntimeMaxSec=30
