[Unit]
Description=AlphaSieve state database backup to the store
RequiresMountsFor=/mnt/private_felixjjiang

[Service]
Type=oneshot
WorkingDirectory=/data/codebase/quant_repo/alphasieve
Environment=ALPHASIEVE_ROLE=system
Environment=ALPHASIEVE_USER=systemd
ExecStart=/data/codebase/quant_repo/alphasieve/.venv/bin/alphasieve state backup --json
StandardOutput=append:/data/alphasieve/logs/state-backup.jsonl
StandardError=append:/data/alphasieve/logs/state-backup.err
TimeoutStartSec=10min
