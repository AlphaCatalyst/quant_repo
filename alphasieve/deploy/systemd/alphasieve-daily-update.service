[Unit]
Description=AlphaSieve incremental market data update
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/private_felixjjiang

[Service]
Type=oneshot
WorkingDirectory=/data/codebase/quant_repo/alphasieve
Environment=ALPHASIEVE_ROLE=system
Environment=ALPHASIEVE_USER=systemd
Environment=ALPHASIEVE_WESTOCK_CLI=/data/codebase/quant_repo/alphasieve/deploy/remote/westock-ssh
Nice=10
CPUWeight=20
ExecStart=/data/codebase/quant_repo/alphasieve/.venv/bin/alphasieve data daily-update --json
StandardOutput=append:/data/alphasieve/logs/daily-update.jsonl
StandardError=append:/data/alphasieve/logs/daily-update.err
TimeoutStartSec=6h
