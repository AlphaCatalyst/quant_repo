[Unit]
Description=AlphaSieve read-only web frontend
After=network-online.target
RequiresMountsFor=/mnt/private_felixjjiang

OnFailure=alphasieve-failure@%n.service

[Service]
Type=simple
WorkingDirectory=/data/alphasieve/deploy/current
Environment=ALPHASIEVE_ROLE=human
Environment=ALPHASIEVE_USER=web
Environment=ALPHASIEVE_WEB_AUTH=none
ExecStart=/data/alphasieve/deploy/current/.venv/bin/alphasieve serve --host 9.134.61.161 --port 8720
StandardOutput=append:/data/alphasieve/logs/web.log
StandardError=append:/data/alphasieve/logs/web.log
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
RuntimeMaxSec=7d

[Install]
WantedBy=multi-user.target
